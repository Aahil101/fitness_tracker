# ---------------------------------------------------------------------------
# Frontend environment. Copy to frontend/.env.local and fill in.
# Only VITE_-prefixed values are exposed to the browser — never put a service
# role key or the Gemini key here.
# ---------------------------------------------------------------------------

# Supabase project (Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# FastAPI backend. Local dev default is http://127.0.0.1:8000
VITE_API_BASE_URL=http://127.0.0.1:8000
