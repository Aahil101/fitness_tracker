# ---------------------------------------------------------------------------
# Backend environment. Copy to backend/.env and fill in.
# Every service below has a free tier that covers 5-10 users.
# ---------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO

# --- Supabase (required) ---------------------------------------------------
# Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Only needed for legacy HS256 projects (Settings -> API -> JWT Secret).
# New projects use asymmetric signing keys and need nothing here.
SUPABASE_JWT_SECRET=

# Optional: admin operations only. The API never needs it for normal use.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=food-photos

# --- Gemini (required for AI features) ------------------------------------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- USDA FoodData Central (required for nutrition lookup) ----------------
# Free key: https://fdc.nal.usda.gov/api-key-signup
# DEMO_KEY works for a quick try but is heavily rate limited.
USDA_API_KEY=DEMO_KEY

# --- Upstash Redis (optional; cache + rate limits) ------------------------
# https://console.upstash.com -> Create database -> REST API
# Without it the app uses an in-process cache, which is fine for one instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Limits & CORS --------------------------------------------------------
RATE_LIMIT_VISION_PER_HOUR=40
RATE_LIMIT_CHAT_PER_HOUR=80
RATE_LIMIT_INSIGHT_PER_HOUR=20
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=8388608
